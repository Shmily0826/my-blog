---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
type Props = CollectionEntry<'blog'>['data'];
const { title, description, pubDate, updatedDate, heroImage, lang } = Astro.props;
const showHero = heroImage && !heroImage.src.includes('blog-placeholder');
---
<!doctype html>
<html lang={lang}>
  <head><BaseHead title={title} description={description} /></head>
  <body class="blog-page blog-article-page">
    <Header />
    <main id="main-content" tabindex="-1" class="article-main container">
      <article>
        <a class="text-link back-link" href="/blog">Back to all notes</a>
        <header class="article-header">
          <div class="article-meta"><FormattedDate date={pubDate} />{updatedDate && <span>Updated <FormattedDate date={updatedDate} /></span>}</div>
          <h1>{title}</h1><p class="article-description">{description}</p>
        </header>
        {showHero && <Image class="article-hero" width={1020} height={510} src={heroImage} alt="" />}
        <div class="article-body"><slot /></div>
        <nav class="article-next" aria-label="Continue reading"><a class="text-link" href="/projects">Explore projects</a><a class="text-link" href="/blog">More notes</a></nav>
      </article>
    </main>
    <Footer />
		<script>
			function setupCopyButtons() {
				document.querySelectorAll('pre').forEach((block) => {
					if (block.parentElement?.classList.contains('code-wrapper')) return;

					const parent = block.parentNode;
					if (!parent) return;

					const wrapper = document.createElement('div');
					wrapper.className = 'code-wrapper';
					parent.insertBefore(wrapper, block);
					wrapper.appendChild(block);

					const button = document.createElement('button');
					button.type = 'button';
					button.className = 'copy-button';
					button.setAttribute('aria-label', 'Copy code block');
					button.textContent = 'Copy';
					wrapper.appendChild(button);

					button.addEventListener('click', async () => {
						const code = block.querySelector('code');
						try {
							await navigator.clipboard.writeText(code?.innerText || '');
							button.textContent = 'Copied!';
							button.classList.add('active');
							setTimeout(() => {
								button.textContent = 'Copy';
								button.classList.remove('active');
							}, 2000);
						} catch (error) {
							console.error('Unable to copy code block:', error);
						}
					});
				});
			}

			setupCopyButtons();
			document.addEventListener('astro:after-swap', setupCopyButtons);
		</script>

  </body>
</html>
<style is:global>
  .article-main { max-width: 780px; padding-block: 30px 24px; }
  .back-link { margin-bottom: 24px; font-size: .85rem; }
  .article-meta { display: flex; flex-wrap: wrap; gap: 12px 24px; color: var(--muted); font-size: .8rem; margin-bottom: 18px; }
  .article-header h1 { font-size: clamp(2.1rem, 4.5vw, 3.25rem); max-width: 25ch; }
  .article-description { margin: 24px 0 0; color: var(--muted); font-size: 1.08rem; max-width: 64ch; }
  .article-header { padding-bottom: 32px; border-bottom: 1px solid var(--line); }
  .article-hero { width: 100%; border-radius: 12px; margin-top: 32px; }
  .article-body { padding-top: 32px; font-size: 1rem; color: var(--ink); }
  .article-body p, .article-body li { line-height: 1.85; }
  .article-body p { margin-bottom: 20px; }
  .article-body h2 { font-size: 1.65rem; margin: 40px 0 16px; }
  .article-body h2:first-child { margin-top: 0; }
  .article-body h3 { font-size: 1.25rem; margin: 32px 0 12px; }
  .article-body ul, .article-body ol { padding-left: 24px; }
  .article-body li { margin-bottom: 8px; }
  .article-body img { border-radius: 10px; }
  .article-body pre code { font-size: .85rem; line-height: 1.7; }
  .article-body table { display: block; overflow-x: auto; }
  .code-wrapper { position: relative; }
  .code-wrapper pre { padding-top: 68px; }
  .copy-button { position: absolute; top: 12px; right: 12px; padding: 6px 12px; min-height: 44px; color: var(--ink); background: var(--surface); border: 1px solid var(--line); border-radius: 5px; font-size: .8rem; }
  .copy-button:hover, .copy-button.active { background: var(--accent-soft); }
  .article-next { display: flex; gap: 24px; margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--line); }
  @media (max-width: 700px) { .article-main { padding-top: 20px; } .article-header h1 { font-size: 2.1rem; } .article-description { font-size: 1rem; } }
</style>
