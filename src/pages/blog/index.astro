---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_HANDLE } from '../../consts';
const posts = (await getCollection('blog', ({ data }) => data.draft === false))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<!doctype html>
<html lang="en">
  <head><BaseHead title={'Blog — ' + SITE_HANDLE} description="Engineering notes from building, debugging, and learning across web, Android, and AI-enabled projects." /></head>
  <body class="blog-page">
    <Header />
    <main id="main-content" tabindex="-1" class="container">
      <section class="page-intro" aria-labelledby="blog-title"><h1 id="blog-title">Engineering notes.</h1><p>Things I built, problems I worked through, and what I learned along the way.</p></section>
      <section class="posts-section" aria-labelledby="posts-title">
        <h2 id="posts-title" class="sr-only">Recent writing</h2>
        <ul class="post-list">{posts.map((post) => <li><article class="post-card">
          <div class="post-meta"><FormattedDate date={post.data.pubDate} /><span>{post.data.lang === 'en' ? 'English' : '中文'}</span></div>
          <div class="post-copy"><h3><a href={'/blog/' + post.id + '/'}>{post.data.title}</a></h3><p>{post.data.description}</p><a class="text-link" href={'/blog/' + post.id + '/'} aria-label={'Read ' + post.data.title}>Read note</a></div>
        </article></li>)}</ul>
        {posts.length === 0 && <p class="empty-note">No published notes yet. You can explore the projects in the meantime.</p>}
      </section>
      <aside class="blog-next"><p>The projects behind the notes.</p><a class="text-link" href="/projects">Explore projects</a><a class="text-link" href="/rss.xml">Subscribe via RSS</a></aside>
    </main>
    <Footer />
  </body>
</html>
<style>
  .posts-section { min-height: 240px; padding-bottom: 40px; }
  .post-list { list-style: none; margin: 0; padding: 0; }
  .post-card { display: grid; grid-template-columns: 170px 1fr; gap: 48px; padding-block: 32px; border-top: 1px solid var(--line); }
  .post-meta { display: flex; flex-direction: column; gap: 8px; color: var(--muted); font-size: .8rem; padding-top: 5px; }
  .post-copy h3 { max-width: 28ch; font-size: clamp(1.5rem, 3vw, 2.1rem); margin-bottom: 18px; }
  .post-copy h3 a { color: var(--ink); text-decoration: none; }
  .post-copy h3 a:hover { text-decoration: underline; }
  .post-copy p { max-width: 62ch; color: var(--muted); }
  .blog-next { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; padding-block: 24px; border-top: 1px solid var(--line); }
  .blog-next p { margin: 0 auto 0 0; color: var(--muted); }
  .empty-note { color: var(--muted); }
  @media (max-width: 700px) { .post-card { grid-template-columns: 1fr; gap: 16px; padding-block: 24px; } .post-meta { flex-direction: row; gap: 16px; } .blog-next { gap: 12px 24px; } .blog-next p { width: 100%; } }
</style>
