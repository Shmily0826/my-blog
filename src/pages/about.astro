---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_HANDLE } from '../consts';
---
<!doctype html>
<html lang="en">
  <head><BaseHead title={'About — ' + SITE_HANDLE} description="Android tools, web experiences, and AI experiments by Shmily0826, with an interest in useful software and visual storytelling." /></head>
  <body class="about-page">
    <Header />
    <main id="main-content" tabindex="-1" class="container">
      <section class="page-intro" aria-labelledby="about-title">
        <h1 id="about-title">Hi, I'm {SITE_HANDLE}.</h1>
        <p>I make Android tools, web experiences, and AI experiments.</p>
      </section>
      <section class="about-story" aria-labelledby="story-title">
        <div class="story-copy">
          <h2 id="story-title">What I like making.</h2>
          <p>I'm interested in software you can use and ideas you can see. Appause explores a pause before opening a distracting app. Sky Scout was a team project about making the night sky easier to explore.</p>
          <p>I also experiment with AI in working software, including Ripple's checkout decisions, and with turning structured output into video.</p>
          <p>I build with AI coding tools. My part includes shaping the workflow, making design choices, reviewing behavior, and testing on a real device. The project pages explain where my work fits, especially on team projects.</p>
        </div>
        <aside class="site-index" aria-label="Explore my work">
          <a href="/projects/appause/"><strong>Appause</strong><span>A small pause before an app opens</span></a>
          <a href="/projects"><strong>More projects</strong><span>Stargazing, AI, and earlier experiments</span></a>
          <a href="https://github.com/Shmily0826" target="_blank" rel="noreferrer"><strong>GitHub</strong><span>Source code and public projects</span></a>
        </aside>
      </section>
      <section class="next-direction" aria-labelledby="next-title">
        <h2 id="next-title">What I'm exploring next.</h2>
        <div><p>AI-assisted creative work, especially video, is another direction I'm exploring. I'll share it here when there's a finished piece worth watching.</p><a class="text-link" href="/blog">Notes from building and learning</a></div>
      </section>
    </main>
    <Footer />
  </body>
</html>
<style>
  .about-story { display: grid; grid-template-columns: 1.4fr 1fr; gap: 80px; padding-block: 12px 44px; }
  .story-copy h2 { font-size: clamp(1.65rem, 3vw, 2.3rem); margin-bottom: 24px; }
  .story-copy p { color: var(--muted); max-width: 64ch; }
  .site-index { align-self: start; padding: 16px 28px; background: var(--accent-soft); border-radius: 14px; }
  .site-index a { display: block; padding-block: 16px; color: var(--ink); text-decoration: none; }
  .site-index a:hover strong { text-decoration: underline; text-underline-offset: .24em; }
  .site-index strong { display: block; margin-bottom: 5px; font-size: .95rem; }
  .site-index span { color: var(--muted); font-size: .85rem; }
  .next-direction { display: grid; grid-template-columns: 1fr 1.8fr; gap: 48px; padding-block: 32px; border-top: 1px solid var(--line); }
  .next-direction h2 { font-size: 1.45rem; }
  .next-direction p { color: var(--muted); max-width: 65ch; }
  @media (max-width: 700px) {
    .about-story { grid-template-columns: 1fr; gap: 24px; }
    .site-index { padding: 12px 24px; }
    .next-direction { grid-template-columns: 1fr; gap: 20px; }
  }
</style>
