---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const projects = [
	{ name: 'Appause', kind: 'Android / wellbeing', description: 'A privacy-first Android app that adds intentional friction before distracting apps open.', detail: 'Users can group distracting apps and configure a short pause before opening them. The project includes local-first storage, usage insights, OEM reliability guidance, and an offline-verified Pro licensing flow.', tech: 'Kotlin · Jetpack Compose · Room · DataStore', status: 'Active development · v0.5.38', href: 'https://github.com/Shmily0826/Appause', accent: 'lime' },
	{ name: 'EchoLearn', kind: 'Web / language learning', description: 'An English-learning app that turns video content into personalized vocabulary and sentence practice.', detail: 'EchoLearn combines transcript retrieval, CEFR-aware AI analysis, interactive word lookup, spaced repetition, optional cloud sync, and a multi-tier caption pipeline for YouTube and Bilibili.', tech: 'React · TypeScript · Firebase · Cloudflare · AI APIs', status: 'Live · Web/PWA + Android', href: 'https://echo-learn.uk', accent: 'blue' },
	{ name: 'CareerXP', kind: 'Web / interview practice', description: 'A job-preparation MVP that turns CV and job-description gaps into structured interview training.', detail: 'The product surfaces weak or unsupported evidence, generates a seven-day practice loop, and tracks progress with transparent scoring, feedback, XP, and spaced repetition.', tech: 'Next.js · TypeScript · Prisma · Zod · Vitest · Playwright', status: 'MVP · Core workflow validated', accent: 'orange' },
];

const focus = [
	['Web', 'TypeScript / JavaScript', 'React · Next.js · Astro', 'Node.js'],
	['Android', 'Kotlin', 'Jetpack Compose', 'Local-first application design'],
	['Data & services', 'SQL · Prisma', 'Firebase · REST APIs', 'Cloudflare / Vercel'],
	['Engineering', 'Git & GitHub', 'Testing and debugging', 'Deployment · AI-assisted development'],
];
---

<!doctype html>
<html lang="en">
	<head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
	<body class="portfolio-page">
		<Header />
		<main>
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero-copy"><p class="eyebrow">Software developer <span>/</span> Auckland, NZ</p><h1 id="hero-title">Building useful<br /><em>things that work.</em></h1><p class="hero-lede">I'm a Master of Information Technology student at the University of Auckland with a Computer Science background. I learn by building real products, working through architecture, debugging, testing, deployment, and iteration.</p><div class="hero-actions"><a class="button button-primary" href="#projects">View projects <span>↓</span></a><a class="text-link" href="https://github.com/Shmily0826" target="_blank" rel="noreferrer">GitHub ↗</a><a class="text-link" href="/about">About ↗</a></div></div>
				<div class="hero-art" aria-label="A small abstract diagram representing an iterative development loop"><div class="art-orbit orbit-one"></div><div class="art-orbit orbit-two"></div><div class="art-core">build<br /><span>→</span><br />learn</div><span class="art-label label-top">01 / make</span><span class="art-label label-bottom">02 / refine</span></div>
			</section>

			<section class="projects-section" id="projects" aria-labelledby="projects-title"><div class="section-heading"><p class="eyebrow">Selected work</p><h2 id="projects-title">Products, not just projects.</h2><p>Small, practical software built from the first question through the messy middle.</p></div><div class="project-grid">{projects.map((project) => <article class={`project-card ${project.accent}`}><div class="card-top"><span class="project-kind">{project.kind}</span><span class="project-mark" aria-hidden="true">↗</span></div><h3>{project.name}</h3><p class="project-description">{project.description}</p><p class="project-detail">{project.detail}</p><div class="card-bottom"><span class="project-tech">{project.tech}</span><span class="project-status">{project.status}</span>{project.href && <a class="card-link" href={project.href} target="_blank" rel="noreferrer" aria-label={`Visit ${project.name}`}>View project ↗</a>}</div></article>)}</div></section>

			<section class="focus-section" aria-labelledby="focus-title"><div class="section-heading compact"><p class="eyebrow">Technical focus</p><h2 id="focus-title">The tools are part of the story.</h2></div><div class="focus-grid">{focus.map(([title, ...items]) => <div class="focus-item"><h3>{title}</h3><ul>{items.map((item) => <li>{item}</li>)}</ul></div>)}</div></section>

			<section class="about-section" aria-labelledby="about-title"><div class="about-label"><p class="eyebrow">A little context</p><span>Based in<br />Auckland, NZ</span></div><div class="about-copy"><h2 id="about-title">Curious about the whole path from idea to shipped software.</h2><p>I have a Computer Science background and am currently studying for a Master of Information Technology at the University of Auckland.</p><p>Most of my learning happens through building. I enjoy taking an idea from an early prototype through implementation, debugging, validation, deployment, and repeated product decisions.</p><p>AI tools are part of my development workflow, but I focus on the engineering decisions around them: requirements, architecture, code review, debugging, testing, and validation.</p><a class="text-link" href="/about">More about me ↗</a></div></section>

			<section class="connect-section" aria-labelledby="connect-title"><p class="eyebrow">Open to conversations</p><h2 id="connect-title">Let's connect.</h2><p>I'm interested in software development opportunities, technical collaboration, and conversations around useful software products.</p><div class="connect-links"><a href="https://github.com/Shmily0826" target="_blank" rel="noreferrer">GitHub ↗</a><a href="/about">About ↗</a><a href="/blog">Blog ↗</a></div></section>
		</main>
		<Footer />
	</body>
</html>

<style>
	@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap');
	:global(:root) { --ink: #202825; --muted: #66716b; --paper: #f4f5ef; --paper-deep: #e8ebe3; --lime: #b9d832; --blue: #90cfe0; --orange: #f5a66d; }
	:global(body.portfolio-page) { background: var(--paper); color: var(--ink); font-family: 'Manrope', sans-serif; font-size: 16px; line-height: 1.6; }
	:global(body.portfolio-page) main { width: auto; max-width: none; margin: 0; padding: 0; }
	:global(body.portfolio-page) h1, :global(body.portfolio-page) h2, :global(body.portfolio-page) h3 { color: var(--ink) !important; text-shadow: none; font-family: 'Manrope', sans-serif; }
	:global(body.portfolio-page) a { color: inherit; }
	.hero, .projects-section, .focus-section, .about-section, .connect-section { max-width: 1220px; margin: 0 auto; padding-left: 2rem; padding-right: 2rem; }
	.hero { min-height: 650px; display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(320px, .85fr); align-items: center; gap: 3rem; padding-top: 4rem; padding-bottom: 5rem; }
	.eyebrow { margin: 0 0 1.2rem; color: var(--muted); font-family: 'DM Mono', monospace; font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; }
	.eyebrow span { color: var(--lime); }
	h1 { max-width: 760px; font-size: clamp(3.7rem, 8vw, 7.5rem); font-weight: 800; letter-spacing: -.085em; line-height: .94; }
	h1 em { color: #78877c; font-style: normal; }
	.hero-lede { max-width: 590px; margin: 2rem 0; color: var(--muted); font-size: 1.04rem; }
	.hero-actions, .connect-links { display: flex; align-items: center; flex-wrap: wrap; gap: 1.25rem; }
	.button { display: inline-flex; gap: 1rem; align-items: center; padding: .9rem 1.2rem; font-family: 'DM Mono', monospace; font-size: .78rem; text-decoration: none; }
	.button-primary { background: var(--ink); color: var(--paper) !important; }
	.button-primary:hover { background: #39463f; }
	.text-link, .connect-links a, .card-link { font-family: 'DM Mono', monospace; font-size: .78rem; text-decoration: underline; text-decoration-color: var(--lime); text-underline-offset: .35rem; }
	.hero-art { position: relative; width: min(100%, 440px); aspect-ratio: 1; justify-self: end; border: 1px solid #d9ded2; border-radius: 50%; background: radial-gradient(circle at center, #edf1e7 0 26%, transparent 26.5%), repeating-radial-gradient(circle at center, transparent 0 72px, #dce2d6 73px 74px); }
	.hero-art::before, .hero-art::after { position: absolute; content: ''; background: #d4dbcf; }
	.hero-art::before { top: 50%; left: 10%; right: 10%; height: 1px; }.hero-art::after { top: 10%; bottom: 10%; left: 50%; width: 1px; }
	.art-orbit { position: absolute; inset: 17%; border: 1px solid #c6d0c1; border-radius: 50%; transform: rotate(32deg) scaleX(.42); }.orbit-two { inset: 11%; transform: rotate(-38deg) scaleX(.38); }
	.art-core { position: absolute; top: 50%; left: 50%; z-index: 1; width: 112px; height: 112px; display: grid; place-content: center; transform: translate(-50%, -50%); border-radius: 50%; background: var(--lime); color: var(--ink); font-family: 'DM Mono', monospace; font-size: .75rem; line-height: 1.25; text-align: center; }.art-core span { color: #708514; }
	.art-label { position: absolute; z-index: 1; color: var(--muted); font-family: 'DM Mono', monospace; font-size: .68rem; }.label-top { top: 22%; right: 4%; }.label-bottom { bottom: 19%; left: 5%; }
	.projects-section { padding-top: 6rem; padding-bottom: 6rem; }.section-heading { max-width: 620px; margin-bottom: 2.8rem; }.section-heading h2, .about-copy h2, .connect-section h2 { margin-bottom: 1rem; font-size: clamp(2rem, 4vw, 3.4rem); letter-spacing: -.06em; line-height: 1.04; }.section-heading > p:last-child { color: var(--muted); }
	.project-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }.project-card { min-height: 465px; display: flex; flex-direction: column; padding: 1.5rem; border-top: 5px solid var(--lime); background: #fff; }.project-card.blue { border-color: var(--blue); background: #f5fbfa; }.project-card.orange { border-color: var(--orange); background: #fff9f2; }.card-top, .card-bottom { display: flex; justify-content: space-between; gap: 1rem; }.project-kind, .project-tech, .project-status { color: var(--muted); font-family: 'DM Mono', monospace; font-size: .72rem; }.project-mark { font-size: 1.4rem; }.project-card h3 { margin: 3rem 0 1rem; font-size: 2rem; letter-spacing: -.06em; }.project-description { margin: 0 0 1rem; font-size: 1.05rem; font-weight: 600; line-height: 1.4; }.project-detail { color: var(--muted); font-size: .95rem; line-height: 1.55; }.card-bottom { flex-wrap: wrap; align-items: end; margin-top: auto; padding-top: 2rem; }.project-tech { width: 100%; color: var(--ink); }.project-status { flex: 1; }.card-link { white-space: nowrap; }
	.focus-section { padding-top: 5rem; padding-bottom: 6rem; border-top: 1px solid #d9ded2; }.compact { margin-bottom: 2rem; }.focus-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2.25rem; }.focus-item { border-left: 2px solid var(--lime); padding-left: 1rem; }.focus-item:nth-child(2) { border-color: var(--blue); }.focus-item:nth-child(3) { border-color: var(--orange); }.focus-item h3 { margin: 0 0 1rem; font-size: 1.05rem; }.focus-item ul { margin: 0; padding: 0; list-style: none; color: var(--muted); font-size: .95rem; line-height: 1.7; }
	.about-section { display: grid; grid-template-columns: .8fr 1.2fr; gap: 5rem; padding-top: 6rem; padding-bottom: 7rem; }.about-label span { color: var(--muted); font-family: 'DM Mono', monospace; font-size: .72rem; }.about-copy { max-width: 680px; }.about-copy p { color: var(--muted); }.about-copy .text-link { display: inline-block; margin-top: 1rem; }.connect-section { margin-bottom: 6rem; padding-top: 4rem; padding-bottom: 4rem; border-top: 1px solid #d9ded2; }.connect-section > p:not(.eyebrow) { max-width: 500px; color: var(--muted); }.connect-links { margin-top: 2rem; }
	:global(body.portfolio-page) :global(a:focus-visible) { outline: 3px solid var(--orange); outline-offset: 4px; }
	@media (max-width: 1100px) { .project-grid { grid-template-columns: repeat(2, 1fr); } }
	@media (max-width: 850px) { .hero { grid-template-columns: 1fr; min-height: auto; padding-top: 5rem; }.hero-art { justify-self: start; width: min(100%, 360px); margin-top: 1rem; }.project-grid { grid-template-columns: 1fr; }.project-card { min-height: 0; }.focus-grid { grid-template-columns: repeat(2, 1fr); }.about-section { grid-template-columns: 1fr; gap: 1rem; } }
	@media (max-width: 520px) { .hero, .projects-section, .focus-section, .about-section, .connect-section { padding-left: 1.2rem; padding-right: 1.2rem; }.hero { padding-top: 3.5rem; padding-bottom: 4rem; } h1 { font-size: clamp(3.2rem, 17vw, 5rem); }.hero-lede { font-size: .95rem; }.focus-grid { grid-template-columns: 1fr; }.projects-section, .focus-section, .about-section { padding-top: 4rem; padding-bottom: 4rem; }.project-card { padding: 1.25rem; }.project-card h3 { margin-top: 2.5rem; } }
	@media (prefers-reduced-motion: reduce) { * { scroll-behavior: auto !important; } }
</style>
