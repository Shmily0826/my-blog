---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import artwork from '../assets/ui/blog-bg.png';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { featuredProjects } from '../data/projects';
const [spotlightProject] = featuredProjects;

const posts = (await getCollection('blog', ({ data }) => data.draft === false))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 2);
---
<!doctype html>
<html lang="en">
  <head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
  <body class="portfolio-page home-concept">
    <Header />
    <main id="main-content" tabindex="-1">
      <section class="art-hero" aria-labelledby="hero-title">
        <Image class="hero-art" src={artwork} widths={[768, 1280, 1920, 2560]} sizes="100vw" alt="" loading="eager" fetchpriority="high" quality={80} />
        <div class="hero-shade" aria-hidden="true"></div>
        <div class="hero-inner container">
          <div class="hero-copy">
            <h1 id="hero-title">Things I build.<br /><span>Notes I keep.</span></h1>
            <p>A space for projects, experiments, and the things I learn along the way.</p>
            <div class="actions">
              <a class="button" href="/projects">Explore projects</a>
              <a class="hero-note-link" href="/blog">Read the notes</a>
            </div>
          </div>
        </div>
      </section>

      <section class="work-section container" id="projects" aria-labelledby="projects-title">
        <div class="section-title">
          <h2 id="projects-title">Something I've built.</h2>
          <p>A small idea that turned into working software.</p>
        </div>
        <article class="work-item">
          <a class="preview-link" href={'/projects#' + spotlightProject.id} aria-label={'Explore ' + spotlightProject.name}>
            <ProjectPreview id={spotlightProject.id} />
          </a>
          <div class="work-copy">
            <div class="work-heading">
              <h3><a href={'/projects#' + spotlightProject.id}>{spotlightProject.name}</a></h3>
              <span>{spotlightProject.category.split(' · ')[0]}</span>
            </div>
            <p>{spotlightProject.description}</p>
            <p>{spotlightProject.overview}</p>
            <a class="text-link" href={'/projects#' + spotlightProject.id}>Explore {spotlightProject.name}</a>
          </div>
        </article>
        <div class="more-work" aria-label="More projects">
          <a class="text-link" href="/projects#sky-scout">Sky Scout</a>
          <a class="text-link" href="/projects#ripple-cart-rescue">Ripple Cart Rescue</a>
          <a class="text-link" href="/projects">All projects and experiments</a>
        </div>
      </section>

      <section class="notebook-section container" aria-labelledby="writing-title">
        <div class="section-title">
          <h2 id="writing-title">From the notebook.</h2>
          <p>What I tried, what got complicated, and what I learned.</p>
        </div>
        {posts.length > 0 ? (
          <div class="note-list">{posts.map((post) => (
            <article class="note-entry">
              <div class="note-meta"><FormattedDate date={post.data.pubDate} /></div>
              <div class="note-copy">
                <h3><a href={'/blog/' + post.id + '/'}>{post.data.title}</a></h3>
                <p>{post.data.description}</p>
                <a class="text-link" href={'/blog/' + post.id + '/'} aria-label={'Read ' + post.data.title}>Read note</a>
              </div>
            </article>
          ))}</div>
        ) : (
          <p class="empty-note">The notebook is quiet for now. There are projects to explore in the meantime.</p>
        )}
        <a class="text-link notebook-link" href="/blog">Open the notebook</a>
      </section>
    </main>
    <Footer />
  </body>
</html>
<style>
  :global(.home-concept .site-footer) { margin-top: 0; }
  .art-hero { position: relative; isolation: isolate; height: 580px; }
  .hero-art { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; object-position: center 42%; }
  .hero-shade {
    position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(90deg, #111520f5 0%, #111520da 24%, #11152070 47%, #1115200d 76%),
      linear-gradient(0deg, #111520 0%, #11152050 20%, transparent 52%);
  }
  .hero-inner { display: flex; align-items: center; min-height: 580px; padding-block: 64px 90px; }
  .hero-copy { max-width: 530px; }
  h1 { font-size: clamp(2.8rem, 4.8vw, 4.15rem); line-height: 1.12; letter-spacing: -.035em; }
  h1 span { color: #dfcdeb; }
  .hero-copy > p { max-width: 36ch; font-size: 1.06rem; line-height: 1.7; color: #e0dce8; margin: 24px 0 28px; }
  .hero-note-link { min-height: 46px; display: inline-flex; align-items: center; padding-inline: 12px; color: #f3f0f8; font-size: .9rem; font-weight: 600; text-decoration-color: #b8a6cd; }
  .actions { gap: 14px; }
  .work-section { padding-block: 44px 62px; }
  .section-title { margin-bottom: 34px; }
  .section-title h2 { font-size: clamp(1.65rem, 3vw, 2.15rem); }
  .section-title > p { color: var(--muted); margin-top: 12px; font-size: .95rem; }
  .work-item { display: grid; grid-template-columns: 1.04fr 1fr; gap: 48px; align-items: center; }
  .work-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 16px; }
  .work-heading h3 { font-size: 1.5rem; }
  .work-heading h3 a { color: var(--ink); text-decoration: none; }
  .work-heading h3 a:hover { text-decoration: underline; }
  .work-heading > span { color: var(--muted); font-size: .76rem; }
  .preview-link { display: block; text-decoration: none; }
  :global(body.home-concept .work-section .project-preview .preview-surface) { height: 292px; }
  .work-copy > p { color: var(--muted); max-width: 47ch; margin: 18px 0 12px; font-size: .95rem; }
  .work-copy > p:first-of-type { color: var(--ink); font-size: 1.15rem; }
  .more-work { display: flex; flex-wrap: wrap; gap: 8px 28px; margin-top: 24px; }
  .notebook-section { padding-block: 46px 60px; border-top: 1px solid var(--line); }
  .note-entry { display: grid; grid-template-columns: 140px minmax(0, 1fr); gap: 38px; padding-block: 12px 24px; }
  .note-entry + .note-entry { border-top: 1px solid var(--line); padding-top: 28px; }
  .note-meta { padding-top: 5px; color: #a9adbf; font-size: .8rem; }
  .note-copy { max-width: 66ch; }
  .note-copy h3 { font-size: 1.35rem; line-height: 1.35; max-width: 40ch; margin-bottom: 12px; }
  .note-copy h3 a { color: var(--ink); text-decoration: none; }
  .note-copy h3 a:hover { text-decoration: underline; }
  .note-copy p { color: var(--muted); font-size: .95rem; margin-bottom: 8px; }
  .notebook-link { margin-top: 8px; }
  .empty-note { color: var(--muted); }
  @media (max-width: 700px) {
    .art-hero { height: auto; }
    .hero-art { height: 430px; object-position: 56% 36%; }
    .hero-shade { background: linear-gradient(0deg, #111520 0%, #111520 22%, #111520d9 41%, #11152025 75%, #11152000 100%); }
    .hero-inner { min-height: 0; padding-block: 325px 32px; }
    h1 { font-size: clamp(2.2rem, 9.6vw, 3rem); }
    .hero-copy > p { max-width: 34ch; margin: 18px 0 22px; font-size: 1rem; }
    .hero-note-link { padding-inline: 5px; font-size: .85rem; }
    .actions { gap: 12px; }
    .work-section { padding-block: 32px 40px; }
    .work-item { grid-template-columns: 1fr; gap: 24px; }
    .section-title { margin-bottom: 26px; }
    :global(body.home-concept .work-section .project-preview .preview-surface) { height: 260px; }
    .notebook-section { padding-block: 34px 40px; }
    .note-entry { grid-template-columns: 1fr; gap: 14px; }
    .note-copy h3 { font-size: 1.2rem; }
  }
</style>
