---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProjectShowcase from '../../components/ProjectShowcase.astro';
import { featuredProjects } from '../../data/projects';
import { SITE_HANDLE } from '../../consts';
export function getStaticPaths() {
  return featuredProjects.map((project) => ({ params: { id: project.id }, props: { project } }));
}
const { project } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head><BaseHead title={project.name + ' — ' + SITE_HANDLE} description={project.description} /></head>
  <body class="projects-page">
    <Header />
    <main id="main-content" tabindex="-1" class="container"><ProjectShowcase project={project} /></main>
    <Footer />
  </body>
</html>
