---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';
import { featuredProjects, otherProjects } from '../data/projects';
import { SITE_HANDLE } from '../consts';
const [appause, skyScout, ripple, echolearn] = featuredProjects;
---
<!doctype html>
<html lang="en">
  <head><BaseHead title={'Projects — ' + SITE_HANDLE} description="Android focus tools, language-learning workflows, and web applications, with implementation details and source links." /></head>
  <body class="projects-page">
    <Header />
    <main id="main-content" tabindex="-1" class="container">
      <section class="page-intro" aria-labelledby="page-title">
        <h1 id="page-title">Selected projects.</h1>
        <p>Web and Android applications, with the problems, decisions, and implementation work behind them.</p>
        <nav class="project-jump" aria-label="Projects on this page"><a href="#appause">Appause</a><a href="#sky-scout">Sky Scout</a><a href="#ripple-cart-rescue">Ripple Cart Rescue</a><a href="#other-title">More projects</a><a href="#echolearn">EchoLearn experiment</a></nav>
      </section>
      <section class="featured-section" aria-labelledby="featured-title">
        <h2 id="featured-title" class="sr-only">Featured Projects</h2>
        <ProjectShowcase project={appause} eager />
        <ProjectShowcase project={skyScout} />
        <ProjectShowcase project={ripple} />
      </section>
      <section class="other-section section" aria-labelledby="other-title">
        <div class="section-title"><h2 id="other-title">More projects</h2><p>An earlier experiment in turning structured model output into video.</p></div>
        <div class="other-list">{otherProjects.map((project) => <article class="other-project">
          <div><h3>{project.name}</h3><span class="project-category">{project.category}</span></div>
          <div><p>{project.description}</p><p class="other-tech">{project.tech}</p></div>
          {project.href && <a class="text-link" href={project.href} target="_blank" rel="noreferrer" aria-label={project.name + ' source code'}>View source</a>}
        </article>)}</div>
      </section>
      <section class="experiment-section" aria-labelledby="experiment-title">
        <div class="section-title"><h2 id="experiment-title">An earlier experiment.</h2><p>A project I explored, with its implementation and limitations.</p></div>
        <ProjectShowcase project={echolearn} />
      </section>
    </main>
    <Footer />
  </body>
</html>
<style>
  .project-jump { display: flex; flex-wrap: wrap; gap: 24px; margin-top: 20px; }
  .project-jump a { font-size: .85rem; min-height: 44px; display: inline-flex; align-items: center; }
  .project-category { color: var(--muted); font-size: .78rem; }
  .experiment-section { padding-bottom: 24px; }
  .other-section { border-top: 1px solid var(--line); }
  .other-project { display: grid; grid-template-columns: 230px 1fr auto; gap: 28px; align-items: start; padding-block: 24px; }
  .other-project + .other-project { border-top: 1px solid var(--line); }
  .other-project h3 { font-size: 1.2rem; margin-bottom: 8px; }
  .other-project p { color: var(--muted); font-size: .9rem; }
  .other-project .other-tech { font-size: .78rem; margin: 0; }
  @media (max-width: 700px) {
    .project-jump { gap: 20px; }
    .other-project { grid-template-columns: 1fr; gap: 12px; }
    .other-project > a { justify-self: start; }
  }
</style>
