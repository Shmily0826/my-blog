---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectTeaser from '../components/ProjectTeaser.astro';
import { featuredProjects, otherProjects } from '../data/projects';
import { SITE_HANDLE } from '../consts';
const [appause, skyScout, ripple, echolearn] = featuredProjects;
---
<!doctype html>
<html lang="en">
  <head><BaseHead title={'Projects — ' + SITE_HANDLE} description="Explore Appause, Sky Scout, and Ripple Cart Rescue through real interfaces, demos, and the work behind them." /></head>
  <body class="projects-page">
    <Header />
    <main id="main-content" tabindex="-1" class="container">
      <section class="page-intro" aria-labelledby="page-title">
        <h1 id="page-title">Selected projects.</h1>
        <p>Things to use, places to explore, and ideas to try.</p>
        <nav class="project-jump" aria-label="Projects on this page"><a href="#appause">Appause</a><a href="#sky-scout">Sky Scout</a><a href="#ripple-cart-rescue">Ripple Cart Rescue</a><a href="#other-title">Earlier experiments</a></nav>
      </section>
      <section aria-labelledby="featured-title">
        <h2 id="featured-title" class="sr-only">Featured projects</h2>
        <ProjectTeaser project={appause} spotlight />
        <div class="project-pair"><ProjectTeaser project={skyScout} /><ProjectTeaser project={ripple} /></div>
      </section>
      <section class="earlier-work" aria-labelledby="other-title">
        <h2 id="other-title">Earlier experiments.</h2>
        <p class="section-description">Some ideas became tools. Others remain useful things to learn from.</p>
        <article class="archive-project" id="echolearn">
          <div><h3>EchoLearn</h3><p class="project-category">{echolearn.status}</p></div>
          <p>{echolearn.description}</p>
          <a class="text-link" href="/projects/echolearn/">Explore the experiment</a>
        </article>
        {otherProjects.map((project) => <article class="archive-project">
          <div><h3>{project.name}</h3><p class="project-category">{project.category}</p></div>
          <p>{project.description}</p>
          <a class="text-link" href="/blog/myproject1/">Read the project note</a>
        </article>)}
      </section>
    </main>
    <Footer />
  </body>
</html>
<style>
  .project-jump { display: flex; flex-wrap: wrap; gap: 8px 24px; margin-top: 20px; }
  .project-jump a { font-size: .85rem; min-height: 44px; display: inline-flex; align-items: center; }
  .project-pair { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; padding-block: 54px 60px; }
  .earlier-work { border-top: 1px solid var(--line); padding-top: 38px; scroll-margin-top: 100px; }
  .earlier-work > h2 { margin-bottom: 16px; }
  .section-description { color: var(--muted); margin-bottom: 26px; }
  .archive-project { display: grid; grid-template-columns: 220px minmax(0, 1fr) auto; gap: 28px; align-items: start; padding-block: 26px; scroll-margin-top: 100px; }
  .archive-project + .archive-project { border-top: 1px solid var(--line); }
  .archive-project h3 { font-size: 1.2rem; margin-bottom: 10px; }
  .archive-project p { color: var(--muted); font-size: .9rem; }
  .archive-project .project-category { font-size: .78rem; }
  @media (max-width: 700px) {
    .project-pair { grid-template-columns: 1fr; gap: 42px; padding-block: 42px; }
    .archive-project { grid-template-columns: 1fr; gap: 10px; }
    .archive-project p { margin-bottom: 0; }
  }
</style>
