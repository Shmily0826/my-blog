---
import { Image } from 'astro:assets';
import ProjectPreview from './ProjectPreview.astro';
import skyPlanning from '../assets/projects/sky-scout-planning.jpg';
import type { featuredProjects } from '../data/projects';
interface Props { project: (typeof featuredProjects)[number]; }
const { project } = Astro.props;
---
<article class="project-detail">
  <header class="project-heading">
    <a class="text-link back-link" href="/projects">All projects</a>
    <h1>{project.name}</h1>
    <p class="project-description">{project.description}</p>
    <p class="project-meta">{project.category}<span>{project.status}</span></p>
    {project.links.length > 0 && <div class="project-links">{project.links.map((link, index) => <a class:list={['button', { 'button-secondary': index > 0 }]} href={link.href} target="_blank" rel="noreferrer">{link.label}</a>)}</div>}
  </header>
  <div class="project-visual"><ProjectPreview id={project.id} eager /></div>
  <section class="experience" aria-labelledby="experience-title">
    <div>
      <h2 id="experience-title">The experience</h2>
      <p>{project.overview}</p>
      <ol>{project.experience.map((step) => <li>{step}</li>)}</ol>
    </div>
    {project.id === 'sky-scout' && <figure class="supporting-image">
      <a href={skyPlanning.src} aria-label="Enlarge Sky Scout observation recommendations"><Image src={skyPlanning} widths={[500, 800, 1120]} sizes="(max-width: 700px) 90vw, 500px" alt="Sky Scout recommendations with visible and best observation times, alongside weather conditions" loading="lazy" /></a>
      <figcaption>Planning what to see · Earlier Web capture</figcaption>
    </figure>}
  </section>
  <section class="contribution" aria-labelledby="contribution-title">
    <h2 id="contribution-title">My part</h2>
    <div><p class="role">{project.role}</p><p>{project.contribution}</p></div>
  </section>
  <section class="decisions" aria-labelledby="decisions-title">
    <h2 id="decisions-title">Behind the experience</h2>
    <div class="decision-copy"><h3>The challenge</h3><p>{project.challenge}</p><h3>The approach</h3><p>{project.decision}</p>
      <ul class="tags" aria-label={project.name + ' technologies'}>{project.tech.map((tech) => <li>{tech}</li>)}</ul>
    </div>
  </section>
  <section class="project-boundary" aria-labelledby="status-title">
    <h2 id="status-title">Current status & limits</h2><p>{project.boundary}</p>
  </section>
  <nav class="project-next" aria-label="More projects"><a class="text-link" href="/projects">Explore another project</a><a class="text-link" href="/blog">Read the notebook</a></nav>
</article>
<style>
  .project-heading { max-width: 820px; padding-block: 22px 36px; }
  .back-link { margin-bottom: 22px; }
  .project-description { font-size: clamp(1.2rem, 2vw, 1.6rem); margin: 22px 0 16px; line-height: 1.55; max-width: 42ch; }
  .project-meta { display: flex; flex-wrap: wrap; gap: 8px 28px; color: var(--muted); font-size: .8rem; margin: 0; }
  .project-visual { max-width: 940px; margin-bottom: 44px; }
  .experience { display: grid; grid-template-columns: minmax(0, 1fr); gap: 36px; padding-bottom: 36px; }
  .experience:has(.supporting-image) { grid-template-columns: 1fr 1fr; }
  h2 { font-size: 1.45rem; margin-bottom: 20px; }
  .experience p { color: var(--muted); max-width: 68ch; }
  ol { padding-left: 23px; margin: 22px 0; }
  li { padding-left: 5px; margin-block: 12px; }
  .project-links { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 26px; }
  .supporting-image { margin: 0; align-self: center; }
  .supporting-image img { width: 100%; height: auto; border-radius: 12px; }
  figcaption { color: var(--muted); font-size: .76rem; margin-top: 12px; }
  .contribution, .decisions, .project-boundary { display: grid; grid-template-columns: 1fr 2fr; gap: 40px; border-top: 1px solid var(--line); padding-block: 32px; }
  .contribution p, .decision-copy p, .project-boundary p { color: var(--muted); max-width: 68ch; }
  .contribution .role { color: var(--ink); font-size: .9rem; }
  .decision-copy h3 { font-size: 1rem; margin-bottom: 12px; }
  .decision-copy h3:not(:first-child) { margin-top: 26px; }
  .project-boundary { font-size: .9rem; }
  .project-next { display: flex; flex-wrap: wrap; gap: 12px 28px; border-top: 1px solid var(--line); padding-top: 16px; }
  @media (max-width: 700px) {
    .project-heading { padding-bottom: 28px; }
    .project-visual { margin-bottom: 30px; }
    .experience:has(.supporting-image), .contribution, .decisions, .project-boundary { grid-template-columns: 1fr; gap: 8px; }
    .experience { padding-bottom: 28px; }
    .supporting-image { margin-top: 20px; }
    .project-meta { gap: 8px; flex-direction: column; }
  }
</style>
