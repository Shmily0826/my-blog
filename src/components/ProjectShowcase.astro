---
import ProjectPreview from './ProjectPreview.astro';
import type { featuredProjects } from '../data/projects';
interface Props { project: (typeof featuredProjects)[number]; eager?: boolean; }
const { project, eager = false } = Astro.props;
---
<article class="featured-project" id={project.id}>
  <div class="project-visual"><ProjectPreview id={project.id} eager={eager} /><p class="project-boundary">{project.boundary}</p></div>
  <div class="project-copy">
    <div class="project-heading"><h3>{project.name}</h3><span>{project.category}</span></div>
    {'status' in project && <p class="project-status">{project.status}</p>}
    <p class="project-description">{project.description}</p>
    <p class="project-overview">{project.overview}</p>
    <ul class="tags" aria-label={project.name + ' technologies'}>{project.tech.map((tech) => <li>{tech}</li>)}</ul>
    <div class="project-links">{project.links.map((link) => <a class="button button-secondary" href={link.href} target="_blank" rel="noreferrer">{link.label}</a>)}</div>
  </div>
  <div class="project-details">
    <div><h4>My contribution</h4><p>{project.contribution}</p></div>
    <div><h4>The engineering problem</h4><p>{project.challenge}</p></div>
    <div><h4>The approach</h4><p>{project.decision}</p></div>
  </div>
</article>
<style>
  .featured-project { display: grid; grid-template-columns: 1.05fr 1fr; gap: 28px 48px; padding-block: 36px 46px; border-top: 1px solid var(--line); scroll-margin-top: 90px; }
  .project-copy { align-self: center; }
  .project-heading h3 { font-size: 2rem; margin-bottom: 8px; }
  .project-heading span { color: var(--muted); font-size: .78rem; }
  .project-status { margin: 16px 0; color: var(--accent); font-size: .85rem; }
  .project-description { font-size: 1.2rem; color: var(--ink); line-height: 1.5; margin: 18px 0 12px; }
  .project-overview { color: var(--muted); font-size: .9rem; }
  .project-links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  .project-boundary { font-size: .78rem; color: var(--muted); margin: 18px 0 0; max-width: 58ch; }
  .project-details { grid-column: 1 / -1; display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 28px; padding-top: 24px; }
  .project-details h4 { font-size: .9rem; letter-spacing: -.01em; margin-bottom: 10px; }
  .project-details p { font-size: .85rem; color: var(--muted); margin: 0; }
  @media (max-width: 700px) {
    .featured-project { grid-template-columns: 1fr; gap: 24px; padding-block: 26px 36px; }
    .project-copy { grid-row: 1; }
    .project-heading h3 { font-size: 1.75rem; }
    .project-description { margin-top: 14px; font-size: 1.1rem; }
    .project-details { grid-template-columns: 1fr; gap: 22px; padding-top: 0; }
    .project-links { margin-top: 18px; }
  }
</style>
