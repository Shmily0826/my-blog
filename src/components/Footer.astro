<style>
	footer { padding: 2.5rem 2rem; color: var(--muted); background: var(--paper-deep); border-top: 1px solid #d9ded2; font-family: 'DM Mono', monospace; font-size: .72rem; }
	.footer-inner { max-width: 1180px; margin: 0 auto; display: flex; justify-content: space-between; gap: 1rem; }
