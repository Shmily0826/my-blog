---
import { Image } from 'astro:assets';
import skyPreview from '../assets/projects/sky-scout-locate.jpg';
---
<section class="sky-demo" aria-labelledby="sky-demo-title" data-sky-demo data-state="idle">
  <div class="demo-heading">
    <div><h2 id="sky-demo-title">Explore the night sky</h2><p>Preset · Auckland, 5 November 2026</p></div>
    <div class="demo-actions">
      <button class="text-link demo-stop" type="button" data-demo-stop hidden>Stop demo</button>
      <a class="text-link" href="/demos/sky-scout/" target="_blank" rel="noreferrer">Open larger view <span class="sr-only">(new tab)</span></a>
    </div>
  </div>
  <div class="demo-viewer">
    <div class="demo-poster" data-demo-poster>
      <Image src={skyPreview} widths={[600, 1000, 1440]} sizes="(max-width: 700px) 100vw, 940px" alt="Sky Scout sky map preview from the project presentation" loading="eager" />
      <div class="demo-launch">
        <button class="button" type="button" data-demo-start>Explore the sky</button>
        <p class="demo-status" role="status" data-demo-status>Interactive demo · Loads on demand. No location or camera access needed.</p>
      </div>
    </div>
    <div class="demo-stage" data-demo-stage hidden></div>
  </div>
  <p class="demo-hint">Drag to look around. Use + / − to zoom and the time slider to change the sky.</p>
  <details class="demo-credit"><summary>About this demo &amp; credits</summary><p>A focused version of the Sky Scout team project. The preview shows an earlier presentation capture; the demo starts at 22:00 NZDT. Star data: <a href="https://www.astronexus.com/projects/hyg" target="_blank" rel="noreferrer">HYG</a>; constellation data: <a href="https://github.com/Stellarium/stellarium-skycultures" target="_blank" rel="noreferrer">Stellarium</a>. <a href="/demos/sky-scout/ATTRIBUTION.txt">Credits &amp; licences</a>.</p></details>
</section>
<script>
  const host = document.querySelector<HTMLElement>('[data-sky-demo]');
  if (host) {
    const start = host.querySelector<HTMLButtonElement>('[data-demo-start]')!;
    const stop = host.querySelector<HTMLButtonElement>('[data-demo-stop]')!;
    const status = host.querySelector<HTMLElement>('[data-demo-status]')!;
    const stage = host.querySelector<HTMLElement>('[data-demo-stage]')!;
    const poster = host.querySelector<HTMLElement>('[data-demo-poster]')!;
    let frame: HTMLIFrameElement | null = null;
    let timeout: number | undefined;
    const clear = () => {
      window.clearTimeout(timeout);
      if (frame) {
        poster.hidden = false;
        start.hidden = false;
        start.focus({ preventScroll: true });
      }
      frame?.remove();
      frame = null;
      stage.hidden = true;
      poster.hidden = false;
      start.hidden = false;
      stop.hidden = true;
    };
    start.addEventListener('click', () => {
      clear();
      host.dataset.state = 'loading';
      status.textContent = 'Loading the night sky… The first load can take a moment.';
      start.hidden = true;
      stop.hidden = false;
      stage.hidden = false;
      stop.textContent = 'Cancel loading';
      host.scrollIntoView({ block: 'start', behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      frame = document.createElement('iframe');
      frame.title = 'Interactive Sky Scout night sky: drag, zoom and adjust observation time';
      frame.src = '/demos/sky-scout/';
      frame.setAttribute('sandbox', 'allow-scripts allow-same-origin');
      frame.allow = "camera 'none'; microphone 'none'; geolocation 'none'";
      frame.referrerPolicy = 'no-referrer';
      stage.append(frame);
      timeout = window.setTimeout(() => {
        clear();
        host.dataset.state = 'error';
        start.textContent = 'Try loading again';
        status.textContent = 'The sky could not finish loading. Try again, or open the larger view.';
        start.focus({ preventScroll: true });
      }, 60000);
    });
    stop.addEventListener('click', () => {
      clear();
      host.dataset.state = 'idle';
      start.textContent = 'Explore the sky';
      status.textContent = 'Demo stopped. Start it again to return to the preset night sky.';
      start.focus({ preventScroll: true });
    });
    window.addEventListener('message', (event: MessageEvent) => {
      if (event.origin !== window.location.origin || event.source !== frame?.contentWindow) return;
      const data = event.data;
      if (!data || data.type !== 'sky-scout-demo-state') return;
      if (typeof data.error === 'string' && data.error) {
        clear();
        host.dataset.state = 'error';
        start.textContent = 'Try loading again';
        status.textContent = 'The star data could not load. Try again, or open the larger view.';
        start.focus({ preventScroll: true });
        return;
      }
      if (data.ready !== true) return;
      window.clearTimeout(timeout);
      const firstReady = host.dataset.state !== 'ready';
      host.dataset.state = 'ready';
      poster.hidden = true;
      stop.textContent = 'Stop demo';
      if (firstReady) frame?.focus({ preventScroll: true });
      for (const key of ['azimuth', 'pitch', 'zoom', 'minute'] as const) {
        if (typeof data[key] === 'number' && Number.isFinite(data[key])) host.dataset[key] = String(data[key]);
      }
      if (status.textContent !== 'Ready. Interact inside the sky window; scroll outside it to continue reading.') {
        status.textContent = 'Ready. Interact inside the sky window; scroll outside it to continue reading.';
      }
    });
  }
</script>
<style>
  .sky-demo { max-width: 940px; margin-bottom: 48px; scroll-margin-top: 8px; }
  .demo-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px 24px; margin-bottom: 12px; }
  h2 { font-size: 1.2rem; scroll-margin-top: 8px; }
  .demo-heading p { color: var(--muted); font-size: .8rem; margin: 6px 0 0; }
  .demo-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 20px; }
  .demo-actions .text-link { font-size: .8rem; }
  .demo-stop { background: none; border: 0; padding: 0; color: var(--muted); text-decoration: underline; }
  .demo-stop:hover { color: var(--ink); }
  .sky-demo [hidden] { display: none; }
  .demo-viewer { position: relative; height: clamp(360px, 65svh, 580px); overflow: hidden; border: 1px solid var(--line); border-radius: 14px; background: #0b0914; }
  .demo-poster, .demo-stage { position: absolute; inset: 0; }
  .demo-poster { z-index: 1; display: grid; place-items: center; }
  .demo-poster img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .4; }
  .demo-launch { position: relative; text-align: center; padding: 24px; max-width: 38ch; }
  .demo-status { color: var(--ink); font-size: .8rem; margin: 16px 0 0; text-wrap: pretty; }
  .demo-stage :global(iframe) { display: block; width: 100%; height: 100%; border: 0; }
  .demo-hint { color: var(--muted); font-size: .8rem; margin: 12px 0; }
  .demo-credit { color: var(--muted); font-size: .76rem; }
  summary { cursor: pointer; width: fit-content; min-height: 32px; }
  .demo-credit p { max-width: 68ch; margin: 8px 0 0; }
  @media (max-width: 700px) {
    .sky-demo { margin-bottom: 32px; }
    .demo-heading { gap: 4px; }
    .demo-viewer { height: clamp(400px, 62svh, 520px); margin-inline: -12px; border-radius: 10px; }
  }
  @media (max-height: 500px) and (orientation: landscape) { .demo-viewer { height: 360px; } }
</style>
