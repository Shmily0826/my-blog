---
import HeaderLink from './HeaderLink.astro';
import { SITE_HANDLE } from '../consts';
---
<a class="skip-link" href="#main-content">Skip to content</a>
<div class="header-wrapper">
  <header class="site-header container">
    <nav class="site-nav" aria-label="Primary navigation">
      <a class="wordmark" href="/" aria-label={SITE_HANDLE + ' home'}>{SITE_HANDLE}<span>.</span></a>
      <div class="internal-links">
        <HeaderLink href="/">Home</HeaderLink>
        <HeaderLink href="/projects">Projects</HeaderLink>
        <HeaderLink href="/blog">Blog</HeaderLink>
        <HeaderLink href="/about">About</HeaderLink>
      </div>
      <a class="github-link text-link" href="https://github.com/Shmily0826" target="_blank" rel="noreferrer">GitHub</a>
    </nav>
  </header>
</div>
