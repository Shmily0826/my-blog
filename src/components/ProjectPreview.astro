---
import { Image } from 'astro:assets';
import appauseGroup from '../assets/projects/appause-group.webp';
import appauseCounting from '../assets/projects/appause-counting.webp';
import appauseContinue from '../assets/projects/appause-continue.webp';
import echolearnStudy from '../assets/projects/echolearn-study.png';
import skyScout from '../assets/projects/sky-scout-locate.jpg';
import rippleWorkflow from '../assets/projects/ripple-workflow.png';
import type { featuredProjects } from '../data/projects';
interface Props { id: (typeof featuredProjects)[number]['id']; eager?: boolean; href?: string; }
const { id, eager = false, href } = Astro.props;
const image = id === 'appause' ? appauseContinue : id === 'echolearn' ? echolearnStudy : id === 'sky-scout' ? skyScout : rippleWorkflow;
const name = { appause: 'Appause', 'sky-scout': 'Sky Scout', 'ripple-cart-rescue': 'Ripple Cart Rescue', echolearn: 'EchoLearn' }[id];
const caption = id === 'appause' ? 'Choose your apps. Take a pause. Decide whether to continue.' : id === 'sky-scout' ? 'Finding Sirius in the sky map · Project presentation capture' : id === 'echolearn' ? 'Earlier guest sample lesson' : 'Workflow illustration from the hackathon presentation';
const appauseScreens = [
  { image: appauseGroup, label: 'Group settings', alt: 'Choose distracting apps and set a pause in Appause group settings' },
  { image: appauseCounting, label: 'Pause countdown', alt: 'A countdown gives you a moment before opening Chrome' },
  { image: appauseContinue, label: 'Continue or cancel', alt: 'After the pause, choose a reason and continue, or cancel' },
];
---
<figure class:list={['project-preview', id]}>
  {id === 'appause' ? (
    <div class="preview-surface">
      <div class:list={['phone-sequence', { 'individual-screens': !href }]}>
        {appauseScreens.map((screen) => (
          <a class="phone-shot" href={href ?? screen.image.src} aria-label={href ? 'Explore ' + name : 'Enlarge Appause: ' + screen.label}>
            <Image src={screen.image} widths={[240, 360]} sizes="(max-width: 700px) 26vw, 190px" alt={screen.alt} loading={eager ? 'eager' : 'lazy'} />
            {!href && <span class="screen-label">{screen.label}</span>}
          </a>
        ))}
      </div>
    </div>
  ) : (
    <a class="preview-surface" href={href ?? image.src} aria-label={href ? 'Explore ' + name : 'Enlarge ' + name + ' image'}>
      <Image class="project-screen" src={image} widths={[600, 1000, 1440]} sizes="(max-width: 700px) 90vw, (max-width: 1100px) 50vw, 720px" alt={id === 'sky-scout' ? 'Sky Scout locating Sirius among stars and constellation lines, with the observation time retained' : id === 'echolearn' ? 'EchoLearn video lesson with interactive transcript and local media import' : 'Illustrative workflow linking Shopify checkout signals, Gemini decisions, Bloomreach actions, and outcome history'} loading={eager ? 'eager' : 'lazy'} />
    </a>
  )}
  <figcaption>{caption}{id === 'appause' && !href && <span> Browse the screenshots and select one to view it full size.</span>}</figcaption>
</figure>
<style>
  .project-preview { margin: 0; min-width: 0; }
  .preview-surface { display: grid; place-items: center; overflow: hidden; border-radius: 14px; background: #202737; text-decoration: none; }
  .phone-sequence { display: flex; align-items: center; justify-content: center; gap: 20px; padding: 30px 24px; width: 100%; }
  .phone-shot { display: block; width: calc((100% - 40px) / 3); max-width: 190px; min-width: 0; color: var(--ink); text-decoration: none; }
  .phone-shot img { width: 100%; height: auto; border-radius: 10px; box-shadow: 0 12px 24px #080c1650; }
  .phone-shot:first-child img { max-height: 345px; object-fit: contain; }
  .screen-label { display: block; text-align: center; font-size: .76rem; line-height: 1.5; margin-top: 14px; }
  .project-screen { width: 100%; height: auto; }
  .echolearn .preview-surface { padding: 16px; }
  .echolearn .project-screen { border-radius: 6px; }
  figcaption { margin-top: 12px; color: var(--muted); font-size: .76rem; line-height: 1.6; }
  @media (max-width: 700px) {
    .phone-sequence { gap: 10px; padding: 24px 14px; }
    .phone-shot { width: calc((100% - 20px) / 3); }
    .phone-shot img { border-radius: 6px; }
    .individual-screens { justify-content: flex-start; overflow-x: auto; gap: 20px; min-width: 0; scroll-snap-type: x mandatory; }
    .individual-screens .phone-shot { flex: 0 0 78%; width: 78%; max-width: 220px; scroll-snap-align: center; }
    .individual-screens .phone-shot:first-child img { max-height: none; }
  }
</style>
