---
import ProjectPreview from './ProjectPreview.astro';
import type { featuredProjects } from '../data/projects';
interface Props { project: (typeof featuredProjects)[number]; spotlight?: boolean; homeCover?: boolean; }
const { project, spotlight = false, homeCover = false } = Astro.props;
const href = '/projects/' + project.id + '/';
const demo = project.links.find((link) => link.label === 'Watch the demo');
---
<article class:list={['project-teaser', { spotlight, 'home-spotlight': homeCover && spotlight }]} id={project.id}>
  <ProjectPreview id={project.id} href={href} homeCover={homeCover} />
  <div class="teaser-copy">
    <h3><a href={href}>{project.name}</a></h3>
    <p class="project-category">{project.category}</p>
    <p class="project-description">{project.description}</p>
    <p class="project-status">{project.status}</p>
    <div class="teaser-links">
      {demo && <a class="button button-secondary" href={demo.href} target="_blank" rel="noreferrer">Watch the demo</a>}
      <a class="text-link" href={href}>Explore {project.name}</a>
    </div>
  </div>
</article>
<style>
  .project-teaser { min-width: 0; scroll-margin-top: 100px; }
  .teaser-copy { padding-top: 22px; }
  h3 { font-size: 1.65rem; }
  h3 a { color: var(--ink); text-decoration: none; }
  h3 a:hover { text-decoration: underline; }
  .project-category { color: var(--muted); font-size: .78rem; margin: 10px 0 16px; }
  .project-description { font-size: 1.12rem; max-width: 42ch; margin-bottom: 14px; line-height: 1.65; }
  .project-status { font-size: .78rem; color: var(--muted); margin-bottom: 4px; }
  .teaser-links { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 24px; margin-top: 12px; }
  .spotlight { display: grid; grid-template-columns: 1.3fr 1fr; gap: 48px; align-items: center; }
  .home-spotlight { grid-template-columns: 1fr 1.2fr; }
  .spotlight .teaser-copy { padding-top: 0; }
  .spotlight h3 { font-size: 2.25rem; }
  .spotlight .project-description { font-size: 1.45rem; max-width: 25ch; }
  @media (max-width: 700px) {
    .spotlight { grid-template-columns: 1fr; gap: 0; }
    .spotlight .teaser-copy { padding-top: 22px; }
    .spotlight h3 { font-size: 1.8rem; }
    .spotlight .project-description { font-size: 1.15rem; max-width: 36ch; }
  }
</style>
